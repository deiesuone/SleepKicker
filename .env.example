# Bot トークン（Discord Developer Portal → Bot → Reset Token）
DISCORD_TOKEN=your_bot_token_here

# 無音とみなす秒数。個人が /sleepkicker timeout 未設定のときのサーバー既定（例: 600=10分）
SILENCE_THRESHOLD_SECONDS=600

# 無音超過ユーザーを退出させるか確認する間隔（秒）。短いほど退出遅れが小さい
CHECK_INTERVAL_SECONDS=10

# サーバー既定の発話検知モード。opus=音量(RMS) / speaking=発話インジケータ。個人は /sleepkicker mode で上書き可
USE_MODE=opus

# Opus 音量判定の PCM RMS しきい値（おおよそ 0〜32767）。0=ゲートなし（音があれば発話扱い）。個人は /sleepkicker volume で上書き可
OPUS_VOLUME_THRESHOLD=1000

# true なら追跡中ユーザーの残り秒・RMS などを1秒ごとに英語ログへ出す
DEBUG_LOG=false

# 優先監視する VC のチャンネル ID（カンマ区切り）。左が最優先。人がいる最左へ移動する。空なら未使用
# 例: 111111111111111111,222222222222222222
PRIORITY_VOICE_CHANNEL_ID=
